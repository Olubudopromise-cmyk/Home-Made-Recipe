# Copy this file to .env.local and fill in the values from your
# Supabase project (Dashboard → Project Settings → API).
#   - Project URL  → VITE_SUPABASE_URL
#   - anon / public key → VITE_SUPABASE_ANON_KEY  (safe to expose: RLS guards the data)
# Never commit .env.local — it is already ignored by .gitignore.
# NEVER put the service_role key in this app or in any VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
